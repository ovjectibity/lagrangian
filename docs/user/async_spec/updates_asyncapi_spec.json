{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Lagrangian Realtime Updates",
    "version": "0.2.0",
    "description": "Training and testing use JSON workload updates. Rust commondef/api/apimessages.rs defines the shared client contract."
  },
  "servers": {
    "appServer": {
      "host": "localhost:8000",
      "pathname": "/api",
      "protocol": "ws",
      "description": "Use wss when the app is served over TLS."
    }
  },
  "channels": {
    "workloadUpdates": {
      "address": "/get_workload_live_updates",
      "description": "Obtain a single-use ticket through POST /get_workload_live_ticket using Bearer authentication. Connect with workload_id and ticket query parameters. History is sent before live updates.",
      "bindings": {
        "ws": {
          "query": {
            "type": "object",
            "required": [
              "workload_id",
              "ticket"
            ],
            "properties": {
              "workload_id": {
                "type": "string"
              },
              "ticket": {
                "type": "string"
              }
            }
          }
        }
      },
      "messages": {
        "server": {
          "$ref": "#/components/messages/ServerMessage"
        },
        "client": {
          "$ref": "#/components/messages/ClientMessage"
        }
      }
    }
  },
  "operations": {
    "receiveUpdates": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/workloadUpdates"
      },
      "messages": [
        {
          "$ref": "#/channels/workloadUpdates/messages/server"
        }
      ]
    },
    "requestHistory": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/workloadUpdates"
      },
      "messages": [
        {
          "$ref": "#/channels/workloadUpdates/messages/client"
        }
      ]
    }
  },
  "components": {
    "messages": {
      "ServerMessage": {
        "name": "WorkloadUpdatesServer",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "$ref": "#/components/schemas/WorkloadUpdatesServer"
          }
        }
      },
      "ClientMessage": {
        "name": "WorkloadUpdatesClient",
        "contentType": "application/json",
        "payload": {
          "schemaFormat": "application/schema+json;version=draft-07",
          "schema": {
            "type": "string",
            "enum": [
              "RequestAllUpdatesMessage"
            ]
          }
        }
      }
    },
    "schemas": {
      "WorkloadUpdatesServer": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "WorkloadUpdatesMessage"
            ],
            "additionalProperties": false,
            "properties": {
              "WorkloadUpdatesMessage": {
                "type": "array",
                "items": {
                  "type": "object",
                  "description": "A WorkloadUpdateUser record, defined in commondef/api/apimessages.rs."
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "WorkloadStoppedMessage"
            ],
            "additionalProperties": false,
            "properties": {
              "WorkloadStoppedMessage": {
                "type": "object",
                "required": [
                  "workload_id",
                  "reason"
                ],
                "properties": {
                  "workload_id": {
                    "type": "string"
                  },
                  "reason": {
                    "oneOf": [
                      {
                        "type": "string",
                        "enum": [
                          "CompletedSuccess",
                          "RequestedByUser"
                        ]
                      },
                      {
                        "type": "object",
                        "required": [
                          "WorkerFailure"
                        ],
                        "properties": {
                          "WorkerFailure": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LogStream",
  "type": "object",
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string"
    },
    "training_experiment_id": {
      "type": "string"
    },
    "training_run_id": {
      "type": "string"
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "created_at",
    "id",
    "training_experiment_id",
    "training_run_id",
    "logs"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestGraphRecord",
  "type": "object",
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string"
    },
    "test_run_id": {
      "type": "string"
    },
    "graph": {
      "$ref": "#/definitions/TestGraph"
    }
  },
  "required": [
    "created_at",
    "id",
    "test_run_id",
    "graph"
  ],
  "definitions": {
    "TestGraph": {
      "type": "object",
      "properties": {
        "test_job_controller": {
          "$ref": "#/definitions/TestJobController"
        }
      },
      "required": [
        "test_job_controller"
      ]
    },
    "TestJobController": {
      "type": "object",
      "properties": {
        "test_params": {
          "$ref": "#/definitions/TestParams"
        },
        "compute_instance": {
          "$ref": "#/definitions/ComputeInstance"
        },
        "acceleration_mode": {
          "$ref": "#/definitions/TrainingAccelerationMode"
        }
      },
      "required": [
        "test_params",
        "compute_instance",
        "acceleration_mode"
      ]
    },
    "TestParams": {
      "type": "object",
      "properties": {
        "num_timesteps": {
          "type": "integer",
          "format": "int32"
        },
        "control_model": {
          "$ref": "#/definitions/ControlModel"
        },
        "simulation_model": {
          "type": "string"
        },
        "num_parallel_envs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "num_timesteps",
        "control_model",
        "simulation_model",
        "num_parallel_envs"
      ]
    },
    "ControlModel": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MLP"
            },
            "content": {
              "$ref": "#/definitions/MLPModel"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "VLA"
            },
            "content": {
              "$ref": "#/definitions/VLAModel"
            }
          },
          "required": [
            "type",
            "content"
          ]
        }
      ]
    },
    "MLPModel": {
      "type": "object",
      "properties": {
        "model_type": {
          "$ref": "#/definitions/ModelType"
        },
        "num_hidden_layers": {
          "type": "integer",
          "format": "int32"
        },
        "hidden_layer_dim": {
          "type": "integer",
          "format": "int32"
        },
        "input_spec": {
          "$ref": "#/definitions/ModelInputSpec"
        },
        "output_dim": {
          "type": "integer",
          "format": "int32"
        },
        "input_dim": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "model_type",
        "num_hidden_layers",
        "hidden_layer_dim",
        "input_spec",
        "output_dim",
        "input_dim"
      ]
    },
    "ModelType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Checkpoint"
            },
            "content": {
              "$ref": "#/definitions/CheckpointType"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "New"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "CheckpointType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Pretrained"
            },
            "content": {
              "$ref": "#/definitions/Pretrained"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Checkpoint"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ]
        }
      ]
    },
    "Pretrained": {
      "type": "string",
      "enum": [
        "Pi0"
      ]
    },
    "ModelInputSpec": {
      "type": "object",
      "properties": {
        "all_cameras": {
          "type": "boolean"
        },
        "qpos_state": {
          "type": "boolean"
        },
        "qvel_state": {
          "type": "boolean"
        },
        "xpos_state": {
          "type": "boolean"
        },
        "xquat_state": {
          "type": "boolean"
        },
        "qdof_state": {
          "type": "boolean"
        },
        "contact_pairs": {
          "description": "Only valid in reward_function.input_spec; forbidden in control/value model specs.",
          "type": "boolean"
        }
      },
      "required": [
        "all_cameras",
        "qpos_state",
        "qvel_state",
        "xpos_state",
        "xquat_state",
        "qdof_state",
        "contact_pairs"
      ]
    },
    "VLAModel": {
      "type": "object",
      "properties": {
        "model_type": {
          "$ref": "#/definitions/ModelType"
        },
        "input_spec": {
          "$ref": "#/definitions/ModelInputSpec"
        },
        "output": {
          "$ref": "#/definitions/ControlPolicyOutputMode"
        }
      },
      "required": [
        "model_type",
        "input_spec",
        "output"
      ]
    },
    "ControlPolicyOutputMode": {
      "type": "string",
      "enum": [
        "TargetPositions",
        "TargetVelocities",
        "TargetTorques"
      ]
    },
    "ComputeInstance": {
      "type": "string",
      "enum": [
        "AWSG4dn"
      ]
    },
    "TrainingAccelerationMode": {
      "type": "string",
      "enum": [
        "MLGPUSimulationCPU",
        "MLGPUSimulationGPU",
        "MLCPUSimulationCPU",
        "AllOnServer"
      ]
    }
  }
}

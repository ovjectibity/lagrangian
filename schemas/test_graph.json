{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TestGraphRecord",
  "type": "object",
  "properties": {
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "id": {
      "type": "string"
    },
    "test_run_id": {
      "type": "string"
    },
    "graph": {
      "$ref": "#/definitions/TestGraph"
    }
  },
  "required": [
    "created_at",
    "id",
    "test_run_id",
    "graph"
  ],
  "definitions": {
    "TestGraph": {
      "type": "object",
      "properties": {
        "test_job_controller": {
          "$ref": "#/definitions/TestJobController"
        }
      },
      "required": [
        "test_job_controller"
      ]
    },
    "TestJobController": {
      "type": "object",
      "properties": {
        "test_method": {
          "$ref": "#/definitions/TestMethod"
        },
        "compute_instance": {
          "$ref": "#/definitions/ComputeInstance"
        },
        "acceleration_mode": {
          "$ref": "#/definitions/TrainingAccelerationMode"
        }
      },
      "required": [
        "test_method",
        "compute_instance",
        "acceleration_mode"
      ]
    },
    "TestMethod": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Custom"
            },
            "content": {
              "$ref": "#/definitions/CustomTestMethod"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Dataset"
            },
            "content": {
              "$ref": "#/definitions/DatasetMethod"
            }
          },
          "required": [
            "type",
            "content"
          ]
        }
      ]
    },
    "CustomTestMethod": {
      "type": "object",
      "properties": {
        "test_params": {
          "$ref": "#/definitions/CustomTestMethodTestParams"
        },
        "control_model": {
          "$ref": "#/definitions/ControlModel"
        },
        "simulation_model": {
          "type": "string"
        }
      },
      "required": [
        "test_params",
        "control_model",
        "simulation_model"
      ]
    },
    "CustomTestMethodTestParams": {
      "type": "object",
      "properties": {
        "num_timesteps": {
          "type": "integer",
          "format": "int32"
        },
        "num_parallel_envs": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "num_timesteps",
        "num_parallel_envs"
      ]
    },
    "ControlModel": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "MLP"
            },
            "content": {
              "$ref": "#/definitions/MLPModel"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "VLA"
            },
            "content": {
              "$ref": "#/definitions/VLAModel"
            }
          },
          "required": [
            "type",
            "content"
          ]
        }
      ]
    },
    "MLPModel": {
      "type": "object",
      "properties": {
        "model_type": {
          "$ref": "#/definitions/ModelType"
        },
        "num_hidden_layers": {
          "type": "integer",
          "format": "int32"
        },
        "hidden_layer_dim": {
          "type": "integer",
          "format": "int32"
        },
        "input_spec": {
          "$ref": "#/definitions/ControlPolicyInputSpec"
        },
        "output_dim": {
          "type": "integer",
          "format": "int32"
        },
        "input_dim": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "model_type",
        "num_hidden_layers",
        "hidden_layer_dim",
        "input_spec",
        "output_dim",
        "input_dim"
      ]
    },
    "ModelType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Checkpoint"
            },
            "content": {
              "$ref": "#/definitions/CheckpointType"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "New"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "CheckpointType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Pretrained"
            },
            "content": {
              "$ref": "#/definitions/Pretrained"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Checkpoint"
            },
            "content": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "content"
          ]
        }
      ]
    },
    "Pretrained": {
      "type": "string",
      "enum": [
        "Pi0"
      ]
    },
    "ControlPolicyInputSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "OrdinaryConfiguration"
            },
            "content": {
              "$ref": "#/definitions/OrdinaryIOStateConfiguration"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "EEFOnlyConfiguration"
            },
            "content": {
              "$ref": "#/definitions/EEFOnlyIOStateConfiguration"
            }
          },
          "required": [
            "type",
            "content"
          ]
        }
      ]
    },
    "OrdinaryIOStateConfiguration": {
      "type": "object",
      "properties": {
        "robot_base_body_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "states": {
          "description": "Only valid in reward_function.input_spec; forbidden in control/value model specs.",
          "type": "array",
          "items": {
            "$ref": "#/definitions/IOState"
          }
        }
      },
      "required": [
        "states"
      ]
    },
    "IOState": {
      "type": "object",
      "properties": {
        "is_diff": {
          "type": "boolean"
        },
        "included_body_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_body_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state_item": {
          "$ref": "#/definitions/IOStateItem"
        }
      },
      "required": [
        "is_diff",
        "included_body_names",
        "excluded_body_names",
        "state_item"
      ]
    },
    "IOStateItem": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Cameras"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "QPos"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "QVel"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "GeneralisedForces"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "XPos"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "XQuat"
            },
            "content": {
              "$ref": "#/definitions/XQuatSpec"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "ContactPairs"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "XQuatSpec": {
      "type": "object",
      "properties": {
        "xquat_state_orientation_type": {
          "$ref": "#/definitions/IOStateOrientationType"
        }
      },
      "required": [
        "xquat_state_orientation_type"
      ]
    },
    "IOStateOrientationType": {
      "type": "string",
      "enum": [
        "Quaternion",
        "AxisAngle"
      ]
    },
    "EEFOnlyIOStateConfiguration": {
      "type": "object",
      "properties": {
        "robot_base_body_name": {
          "type": "string"
        },
        "gripper_body_name": {
          "type": "string"
        },
        "end_effector_body_name": {
          "type": "string"
        },
        "eef_state": {
          "$ref": "#/definitions/IOState"
        },
        "qpos_gripper_state": {
          "$ref": "#/definitions/IOState"
        }
      },
      "required": [
        "robot_base_body_name",
        "gripper_body_name",
        "end_effector_body_name",
        "eef_state",
        "qpos_gripper_state"
      ]
    },
    "VLAModel": {
      "type": "object",
      "properties": {
        "model_type": {
          "$ref": "#/definitions/ModelType"
        },
        "input_spec": {
          "$ref": "#/definitions/ControlPolicyInputSpec"
        },
        "output": {
          "$ref": "#/definitions/ControlPolicyOutputSpec"
        }
      },
      "required": [
        "model_type",
        "input_spec",
        "output"
      ]
    },
    "ControlPolicyOutputSpec": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "OrdinaryConfiguration"
            },
            "content": {
              "$ref": "#/definitions/OrdinaryIOStateConfiguration"
            }
          },
          "required": [
            "type",
            "content"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "EEFOnlyConfiguration"
            },
            "content": {
              "$ref": "#/definitions/EEFOnlyIOStateConfiguration"
            }
          },
          "required": [
            "type",
            "content"
          ]
        }
      ]
    },
    "DatasetMethod": {
      "type": "object",
      "properties": {
        "dataset": {
          "$ref": "#/definitions/Dataset"
        },
        "control_model": {
          "$ref": "#/definitions/ControlModel"
        }
      },
      "required": [
        "dataset",
        "control_model"
      ]
    },
    "Dataset": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "Libero"
            },
            "content": {
              "$ref": "#/definitions/LiberoDatasetParams"
            }
          },
          "required": [
            "type",
            "content"
          ]
        }
      ]
    },
    "LiberoDatasetParams": {
      "type": "object",
      "properties": {
        "tasks_index": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "int32"
          }
        },
        "libero_dataset_type": {
          "$ref": "#/definitions/LiberoDatasetType"
        },
        "num_envs_per_task": {
          "type": "integer",
          "format": "int32"
        },
        "num_timesteps": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "tasks_index",
        "libero_dataset_type",
        "num_envs_per_task",
        "num_timesteps"
      ]
    },
    "LiberoDatasetType": {
      "type": "string",
      "enum": [
        "Libero10",
        "Libero90",
        "LiberoGoal",
        "LiberoObject",
        "LiberoSpatial"
      ]
    },
    "ComputeInstance": {
      "type": "string",
      "enum": [
        "AWSG4dn"
      ]
    },
    "TrainingAccelerationMode": {
      "type": "string",
      "enum": [
        "MLGPUSimulationCPU",
        "MLGPUSimulationGPU",
        "MLCPUSimulationCPU",
        "AllOnServer"
      ]
    }
  }
}
